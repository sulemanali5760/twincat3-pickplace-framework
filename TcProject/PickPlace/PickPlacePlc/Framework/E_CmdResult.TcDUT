<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="E_CmdResult" Id="{4a7d9ed1-2ff3-4cd0-8ad8-f2a7fa8c367e}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
{attribute 'strict'}
TYPE E_CmdResult :
(
    eBusy  := 0,   // command still running, keep calling it
    eDone  := 1,   // command finished successfully -> advance the step
    eError := 2    // command failed (e.g. move timeout) -> handle the error
) DINT;
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>